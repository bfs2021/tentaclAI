# SSH config for tentaclai (mounted as /root/.ssh in the container)
#
# New host: create config.d/<name>.conf with a Host block, e.g.
#   Host nas
#       HostName nas.example.lan
#       User admin
# then authorize the public key on that host:
#   keys/tentaclai_ed25519.pub
# No restart needed – ssh reads this on every connect.

Include ~/.ssh/config.d/*.conf

Host *
    # every connection leaves through the egress gateway (direct when there is none)
    ProxyCommand tc-connect %h %p
    IdentityFile ~/.ssh/keys/tentaclai_ed25519
    IdentitiesOnly yes
    # New hosts are trusted on first connect, changed keys are refused
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
    ServerAliveCountMax 4
    # Reuse connections – many short ssh calls in a row stay fast
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
