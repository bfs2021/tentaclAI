{
  "_meta": {
    "title": "Mailcow",
    "category": "Network"
  },
  "description": "Mailcow – domains, mailboxes, aliases (careful!)",
  "api": {
    "base_url": "https://mail.{{DOMAIN}}/api/v1",
    "auth": {
      "type": "header",
      "header": "X-API-Key",
      "value": "${MAILCOW_API_KEY}"
    },
    "docs": "https://mailcow.docs.apiary.io/"
  },
  "test_path": "/get/status/containers",
  "notes": [
    "Prefer a read-only key; changes only when explicitly asked."
  ]
}
