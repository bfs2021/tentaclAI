{
  "_meta": {
    "title": "Proxmox VE",
    "category": "Docker & Infra",
    "setup": "Datacenter → Permissions → API Tokens. PVE_TOKEN_ID e.g. claude@pve!tentaclaude, ideally PVEAuditor only."
  },
  "description": "Proxmox VE – VMs, containers, storage",
  "api": {
    "base_url": "https://pve.{{DOMAIN}}:8006/api2/json",
    "auth": {
      "type": "header",
      "header": "Authorization",
      "value": "PVEAPIToken=${PVE_TOKEN_ID}=${PVE_TOKEN_SECRET}"
    },
    "insecure_tls": true,
    "docs": "https://pve.proxmox.com/pve-docs/api-viewer/"
  },
  "test_path": "/version",
  "examples": [
    "svc NAME GET /nodes",
    "svc NAME GET /cluster/resources"
  ]
}
