{
  "_meta": {
    "title": "Git repo (GitHub, private, write)",
    "category": "Git repos"
  },
  "description": "Your own GitHub repo – clone, commit, push",
  "git": {
    "url": "https://github.com/OWNER/REPO.git",
    "access": "write",
    "branch": "main",
    "auth": {
      "type": "token",
      "token": "${GH_TOKEN}",
      "username": "x-access-token"
    }
  },
  "notes": [
    "Set access to \"read\" if Claude should only read."
  ]
}
