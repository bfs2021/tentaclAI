{
  "_meta": {
    "title": "Custom MCP server (stdio/npx)",
    "category": "General"
  },
  "description": "Locally started MCP server",
  "mcp": {
    "type": "stdio",
    "access": "read",
    "command": "npx",
    "args": [
      "-y",
      "@scope/some-mcp-server"
    ],
    "env": {
      "SOME_API_KEY": "${SOME_API_KEY}"
    }
  }
}
