def cmd_test(services, name):
    svc = get(services, name)
    if not enabled(svc):
        print(f"– {name}: disabled")
        return 1
    ok_all = True

    def report(part, ok, msg):
        nonlocal ok_all
        ok_all &= ok
        print(f"{'✓' if ok else '✗'} {part}: {msg}")

    for part in PARTS:
        if part not in svc:
            continue
        miss = missing_vars(svc[part])
        if miss:
            report(part, False, f"empty in .env: {', '.join(miss)}")
            continue
        if part == "api":
            path = svc.get("test_path", "/")
            r = subprocess.run([sys.argv[0], name, "GET", path, "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10"],
                               capture_output=True, text=True)
            code = r.stdout.strip()
            good = r.returncode == 0 and code[:1] in ("2", "3")
            report("api", good, f"GET {path} → HTTP {code or '–'}" + ("" if good else f" {r.stderr.strip()[-120:]}"))
        elif part == "mcp":
            m = render(svc["mcp"])
            if m.get("type", "http") in ("http", "sse"):
                hdr = [f"{k}: {v}" for k, v in (m.get("headers") or {}).items()]
                cfg = [f"url = {_q(m['url'])}", 'header = "Accept: application/json, text/event-stream"'] + [f"header = {_q(h)}" for h in hdr]
                rc, out, err = _curl_secret(["-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10"] + (["-k"] if m.get("insecure_tls") else []), cfg)
                good = rc == 0 and out not in ("", "000", "401", "403", "404")
                report("mcp", good, f"{m['url']} reachable → HTTP {out or '–'}" + (" (authentication rejected)" if out in ("401", "403") else ""))
            else:
                found = subprocess.run(["sh", "-c", f"command -v {m.get('command', '')}"], capture_output=True).returncode == 0
                report("mcp", found, f"stdio command {m.get('command')} {'found' if found else 'not found'}")
        elif part == "git":
            g = render(svc["git"])
            r = git_run(remote_args(name, g) + ["ls-remote", "--heads", g["url"]], quiet=True)
            heads = len(r.stdout.splitlines())
            report("git", r.returncode == 0, f"{g['url']} → {heads} Branches" if r.returncode == 0 else (r.stderr.strip()[-160:] or "error"))
        elif part == "docker":
            d = render(svc["docker"])
            argv = docker_argv(name, d, ["version", "--format", "{{.Server.Version}}"])
            r = subprocess.run(argv, capture_output=True, text=True, timeout=40)
            if r.returncode != 0 and "context" in r.stderr and "not found" in r.stderr:
                sync_docker_contexts(services)
                r = subprocess.run(argv, capture_output=True, text=True, timeout=40)
            report("docker", r.returncode == 0, f"Docker {r.stdout.strip()}" if r.returncode == 0 else r.stderr.strip()[-160:])
        elif part in ("db", "web", "files"):
            try:
                ok, detail = {"db": db_test, "web": web_test, "files": files_test}[part](name, render(svc[part]))
            except (subprocess.TimeoutExpired, OSError, KeyError) as e:
                ok, detail = False, f"error: {e}"
            report(part, ok, detail)
    return 0 if ok_all else 1


