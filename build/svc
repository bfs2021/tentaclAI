def files_target(name, f):
    host = f.get("ssh_host") or sys.exit(f"svc: {name}: files.ssh_host missing (or a system with an SSH host)")
    root = (f.get("path") or "").rstrip("/") or sys.exit(f"svc: {name}: files.path missing")
    sudo = ssh_sudo(host) if f.get("sudo") else ""
    return host, root, sudo


def files_sub(root, sub):
    sub = (sub or "").strip()
    if sub.startswith("/") or ".." in sub.split("/"):
        sys.exit("svc: paths are relative to the service path and may not contain '..'")
    return root + ("/" + sub if sub and sub != "." else "")


def files_ssh(host, sudo, cmd):
    return subprocess.call(["ssh", host, (sudo + " " if sudo else "") + cmd])


def cmd_files(services, args):
    fs = part_services(services, "files")
    if not args:
        if not fs:
            print("No file services.")
            return 0
        print(f"{'Name':<16}{'Access':<8}{'Target':<44}Status")
        for n, s in fs.items():
            f = render(s["files"])
            print(f"{n:<16}{f.get('access', 'ro'):<8}{(f.get('ssh_host') or '?') + ':' + f.get('path', ''):<44}{status(s)}")
        return 0
    if len(args) < 2:
        sys.exit("usage: svc files <name> ls|tree|cat|grep|pull|diff|push [path]")
    name, op, rest = args[0], args[1], args[2:]
    f = get_part(services, name, "files")
    host, root, sudo = files_target(name, f)
    local = os.path.join("/workspace/files", name)
    if op == "ls":
        return files_ssh(host, sudo, f"ls -la --group-directories-first {shlex.quote(files_sub(root, rest[0] if rest else ''))}")
    if op == "tree":
        return files_ssh(host, sudo, f"find {shlex.quote(files_sub(root, rest[0] if rest else ''))} -maxdepth {int(f.get('tree_depth', 3))} "
                                     f"-not -path '*/.git/*' | sort | head -500")
    if op == "cat" and rest:
        return files_ssh(host, sudo, f"cat {shlex.quote(files_sub(root, rest[0]))}")
    if op == "grep" and rest:
        return files_ssh(host, sudo, f"grep -rIn --color=never -m 20 -e {shlex.quote(rest[0])} "
                                     f"{shlex.quote(files_sub(root, rest[1] if len(rest) > 1 else ''))} | head -300")
    if op in ("pull", "diff", "push"):
        sub = rest[0] if rest else ""
        remote, dest = files_sub(root, sub), os.path.join(local, sub) if sub else local
        if op == "push" and access_mode(f) == "ro":
            audit(name, "files", "ro", f"push {sub or '.'} → {host}:{remote}", "blocked")
            sys.exit(f"svc: {name} is read-only – push is not allowed")
        is_dir = subprocess.run(["ssh", host, (sudo + " " if sudo else "") + f"test -d {shlex.quote(remote)}"]).returncode == 0
        src_r = remote + "/" if is_dir else remote
        base = ["rsync", "-a", "--exclude=.git/"] + ([f"--rsync-path={sudo} rsync"] if sudo else [])
        # root talks to the host (SSH key); the local side is copied as Claude through a private staging dir,
        # so root never reads or writes a path inside Claude's workspace (symlinks there can't redirect it)
        claude = as_user(CLAUDE_USER)
        stage = stage_dir()
        try:
            st = os.path.join(stage, "x") + ("/" if is_dir else "")
            if op == "pull":
                r = subprocess.call(base + [f"{host}:{src_r}", st])
                if r != 0:
                    return r
                give(stage, CLAUDE_USER)
                r = subprocess.call(["sh", "-c", 'mkdir -p "$1" && rsync -a "$2" "$3"', "sh", dest if is_dir else os.path.dirname(dest) or local,
                                     st, dest.rstrip("/") + "/" if is_dir else dest], **claude)
                if r == 0:
                    print(f"→ {dest}  (edit there; changes go back with: svc files {name} diff|push{' ' + sub if sub else ''})")
                return r
            give(stage, CLAUDE_USER)
            if subprocess.call(["test", "-e", dest], **claude) != 0:
                sys.exit(f"svc: {dest} not found – pull first")
            if subprocess.call(["rsync", "-a", "--exclude=.git/", dest.rstrip("/") + "/" if is_dir else dest, st], **claude) != 0:
                sys.exit(f"svc: could not read {dest}")
            out = base + ["--no-owner", "--no-group"]  # the staged copy belongs to Claude – keep the host's owners
            if op == "diff":
                return subprocess.call(out + ["-n", "-i", "--checksum", st, f"{host}:{src_r}"])
            return guarded(name, "files", access_mode(f), f"push {sub or '.'} → {host}:{remote}",
                           lambda: subprocess.call(out + ["-i", st, f"{host}:{src_r}"]))
        finally:
            shutil.rmtree(stage, ignore_errors=True)
    sys.exit("usage: svc files <name> ls|tree|cat <file>|grep <pattern> [path]|pull|diff|push [path]")


def files_test(name, f):
    host, root, sudo = files_target(name, f)
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host,
                        (sudo + " " if sudo else "") + f"sh -c 'if [ -d {shlex.quote(root)} ]; then echo dir $(ls -A {shlex.quote(root)} | wc -l); "
                        f"elif [ -e {shlex.quote(root)} ]; then echo file; else echo missing; fi'"],
                       capture_output=True, text=True, timeout=30)
    out = r.stdout.strip()
    if r.returncode != 0:
        return False, (r.stderr.strip().splitlines() or ["ssh failed"])[-1][:180]
    if out.startswith("dir"):
        return True, f"{host}:{root} – directory, {out.split()[1]} entries ({f.get('access', 'ro')}{', sudo' if sudo else ''})"
    if out == "file":
        return True, f"{host}:{root} – file ({f.get('access', 'ro')})"
    return False, f"{host}:{root} not found"


# ---------- ssh ----------

# Read-only commands that `svc ssh` runs without approval (also on ro hosts): status only, no file contents
# (cat/grep could read a host's .env – those need approval). No shell syntax: one plain command, checked word by word.
SSH_READ = {"uptime", "df", "free", "ps", "ls", "hostname", "whoami", "id", "uname", "date", "lsblk", "findmnt",
            "nproc", "lscpu", "vmstat", "iostat", "who", "w", "last", "docker", "systemctl", "journalctl", "ip", "ss"}
SSH_SHELL_CHARS = set(";&|$`<>(){}\\\n")
SYSTEMCTL_READ = {"status", "is-active", "is-enabled", "is-failed", "list-units", "list-unit-files", "list-timers",
                  "list-sockets", "list-dependencies", "show", "cat", "--failed"}
JOURNAL_WRITE = ("--vacuum", "--rotate", "--flush", "--sync", "--relinquish", "--smart-relinquish", "--setup-keys",
                 "--update-catalog")


def ssh_read_only(alias, cmd):
    """True for a plain status command from SSH_READ (optionally behind the host's sudo prefix)"""
    text = " ".join(cmd)
    if not cmd or any(c in SSH_SHELL_CHARS for c in text):
        return False
    try:
        words = shlex.split(text)
    except ValueError:
        return False
    sudo = shlex.split(ssh_sudo(alias) or "")
    if sudo and words[:len(sudo)] == sudo:
        words = words[len(sudo):]
    if not words or words[0] not in SSH_READ:
        return False
    head, rest = words[0], words[1:]
    args = [a for a in rest if not a.startswith("-")]
    if head == "docker":
        return bool(args) and _ro_allowed(rest)
    if head == "systemctl":
        return bool(args or rest) and all(a in SYSTEMCTL_READ for a in args[:1] or rest[:1])
    if head == "journalctl":
        return not any(a.startswith(JOURNAL_WRITE) for a in rest)
    if head == "ip":
        return not args or args[0] in ("a", "addr", "address", "r", "route", "l", "link", "n", "neigh") and \
            not any(a in ("add", "del", "delete", "set", "change", "replace", "flush", "append") for a in args[1:])
    if head == "ss":
        return not any(a in ("-K", "--kill") or (a.startswith("-") and not a.startswith("--") and "K" in a) for a in rest)
    return True

def cmd_ssh(name_args):
    """a command (or an interactive shell) on an SSH host – the key stays with svc; access per host (default confirm)"""
    if not name_args:
        print(f"{'Host':<16}{'Access':<9}{'User':<10}{'Hostname':<30}sudo")
        for h in tclib.ssh_hosts(SSH_CONF_D):
            print(f"{h['alias']:<16}{tclib.ssh_access(SSH_CONF_D, h['alias']):<9}{h['user'] or '–':<10}{h['hostname'] or '–':<30}{h['sudo'] or '–'}")
        return 0
    alias, cmd = name_args[0], name_args[1:]
    if cmd[:1] == ["--"]:
        cmd = cmd[1:]
    if not tclib.ssh_host(SSH_CONF_D, alias):
        sys.exit(f"svc: unknown SSH host '{alias}' (svc ssh)")
    mode = tclib.ssh_access(SSH_CONF_D, alias)
    remote = " ".join(cmd)
    tty = not cmd or sys.stdin.isatty() and sys.stdout.isatty()
    argv = ["ssh"] + (["-t"] if tty else ["-T"]) + ["--", alias] + ([remote] if remote else [])
    if ssh_read_only(alias, cmd):
        return subprocess.call(argv)
    return guarded(alias, "ssh", mode, f"ssh {alias} {remote}" if remote else f"ssh {alias} (interactive shell)",
                   lambda: subprocess.call(argv))


def cmd_config(services, args):
    """Claude proposes a service file or the site rules; the user approves every write (the stack dir is root's)"""
    if len(args) < 3 or args[0] != "put" or args[1] not in ("service", "local") or (args[1] == "service" and len(args) < 4):
        sys.exit("usage: svc config put service <name> <file>  |  svc config put local <file>")
    if args[1] == "service":
        name, src = args[2], args[3]
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,40}", name):
            sys.exit("svc: service names: a-z 0-9 _ - (max 41)")
        target = os.path.join(SERVICES_DIR, f"{name}.json")
    else:
        name, src = "local", args[2]
        target = os.path.join(TC_DIR, "local", "CLAUDE.md")
    r = subprocess.run(["cat", "--", src], capture_output=True, **as_user(CLAUDE_USER))  # read with Claude's rights
    if r.returncode != 0:
        sys.exit(f"svc: can't read {src}: {r.stderr.decode(errors='replace').strip()[:160]}")
    text = r.stdout.decode("utf-8", "replace")
    if len(text) > 512 * 1024:
        sys.exit("svc: file too large")
    old = open(target).read() if os.path.exists(target) else None
    if args[1] == "service":
        try:
            data = json.loads(text)
        except ValueError as e:
            sys.exit(f"svc: invalid JSON: {e}")
        if not isinstance(data, dict):
            sys.exit("svc: a service file is a JSON object")
        access = ", ".join(f"{p} {data[p].get('access', '–')}" for p in PARTS if isinstance(data.get(p), dict)) or "no parts"
        action = f"{'change' if old is not None else 'create'} services/{name}.json ({access})"
    else:
        action = f"{'change' if old is not None else 'create'} local/CLAUDE.md ({len(text.splitlines())} lines)"
    if old == text:
        print("unchanged")
        return 0
    if old is not None:
        import difflib
        diff = list(difflib.unified_diff(old.splitlines(), text.splitlines(), lineterm="", n=0))
        added, removed = sum(1 for l in diff if l.startswith("+") and not l.startswith("+++")), \
            sum(1 for l in diff if l.startswith("-") and not l.startswith("---"))
        action += f", +{added}/-{removed} lines"

    def write():
        if old is not None:
            shutil.copy2(target, f"{target}.bak-{time.strftime('%Y-%m-%d-%H%M%S')}")
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target + ".tmp", "w") as f:
            f.write(text)
        os.replace(target + ".tmp", target)
        print(f"✓ {os.path.relpath(target, TC_DIR)} written" + (" (previous version kept as .bak-…)" if old is not None else ""))
        if args[1] == "service":
            cmd_sync(load())
        else:
            write_instructions()
        return 0
    return guarded(name if args[1] == "service" else "local", "config", "confirm", action, write)


