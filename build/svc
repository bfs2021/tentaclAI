# ---------- audit log and approvals (access mode "confirm") ----------
# Every write through svc is logged; with access "confirm" it first needs the user's approval in tentacontrol (Activity).
# Claude runs as an unprivileged user and reaches services only through svc (sudo), so the modes are enforced here.

CONTROL_INTERNAL = os.environ.get("TC_CONTROL_INTERNAL", "http://tentacontrol:8080")
AUDIT_FILE = os.path.join(TC_DIR, "data", "control", "audit.jsonl")
TOKEN_FILE = os.path.join(TC_DIR, "data", "control", "svc-token")
APPROVAL_TIMEOUT = 600
MODES = ("ro", "rw", "confirm")


def access_mode(part, default="ro"):
    mode = str(part.get("access", default))
    return mode if mode in MODES else "ro"


def audit(service, part, mode, action, decision, rc=None, duration=None, detail=""):
    """append one line to the audit log – never lets the command fail"""
    entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "service": service, "part": part, "mode": mode,
             "action": action[:500], "decision": decision}
    if rc is not None:
        entry["exit"] = rc
    if duration is not None:
        entry["seconds"] = round(duration, 1)
    if detail:
        entry["detail"] = detail[:300]
    try:
        import fcntl
        os.makedirs(os.path.dirname(AUDIT_FILE), exist_ok=True)
        if os.path.exists(AUDIT_FILE) and os.path.getsize(AUDIT_FILE) > 5 * 2**20:
            os.replace(AUDIT_FILE, AUDIT_FILE + ".1")
        with open(AUDIT_FILE, "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"svc: audit log not writable ({e})", file=sys.stderr)


def _control(method, path, payload=None, timeout=40):
    import urllib.request
    try:
        token = open(TOKEN_FILE).read().strip()
    except OSError:
        raise RuntimeError("no svc token from tentacontrol (data/control/svc-token) – is tentacontrol running?")
    req = urllib.request.Request(CONTROL_INTERNAL + path, method=method,
                                 data=json.dumps(payload).encode() if payload is not None else None,
                                 headers={"X-TC-Token": token, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def request_approval(service, part, action):
    """('approved'|'denied'|'expired'|'error', who/why) – waits for the user's decision in tentacontrol"""
    try:
        res = _control("POST", "/internal/approvals", {"service": service, "part": part, "action": action})
        rid = res["id"]
    except Exception as e:  # noqa: BLE001
        return "error", f"tentacontrol not reachable: {e}"
    if res.get("status") == "approved":  # an active "Approve + 15 min" grant
        return "approved", res.get("by", "grant")
    where = (os.environ.get("CONTROL_URL") or "").rstrip("/")
    where = f"{where}/activity" if where else "tentacontrol → Activity"
    print(f"svc: ⏳ approval needed – {where} (request #{rid}, up to {APPROVAL_TIMEOUT // 60} min): {action}",
          file=sys.stderr, flush=True)
    start = time.time()
    end = start + APPROVAL_TIMEOUT + 30
    reminded = start
    while time.time() < end:
        if time.time() - reminded >= 60:  # visible in the live output of a running command
            reminded = time.time()
            print(f"svc: ⏳ still waiting for approval #{rid} ({int(reminded - start) // 60} min) – {where}", file=sys.stderr, flush=True)
        try:
            st = _control("GET", f"/internal/approvals/{rid}?wait=25", timeout=40)
        except Exception as e:  # noqa: BLE001
            return "error", f"tentacontrol not reachable: {e}"
        if st.get("status") != "pending":
            return st.get("status", "error"), st.get("by", "")
    return "expired", ""


def guarded(service, part, mode, action, run):
    """run() performs a write: blocked for ro, logged for rw, approved first for confirm"""
    if mode == "ro":
        audit(service, part, mode, action, "blocked")
        sys.exit(f"svc: {service} is read-only ({part}) – '{action[:80]}' is not allowed")
    decision, by = "auto", ""
    if mode == "confirm":
        decision, by = request_approval(service, part, action)
        if decision != "approved":
            audit(service, part, mode, action, decision, detail=by)
            sys.exit(f"svc: {service}: {action[:80]} – {decision}{(' (' + by + ')') if by else ''}. "
                     "Not executed – tell the user, don't work around it.")
        print(f"svc: ✓ approved{' – ' + by if by.startswith('grant') else ''}", file=sys.stderr, flush=True)
    t = time.time()
    rc = run()
    audit(service, part, mode, action, decision, rc=rc, duration=time.time() - t, detail=by)
    return rc


