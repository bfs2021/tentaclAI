# ---------- docker ----------

def ssh_sudo(alias):
    """sudo prefix configured for an SSH host ('# tentaclai: sudo=sudo -n' inside its Host block), '' = none"""
    return tclib.ssh_sudo(SSH_CONF_D, alias)


def docker_sudo(d):
    return ssh_sudo(d["ssh_host"]) if d.get("mode", "socket") == "ssh" else ""


def wants_tty(args, compose=False):
    """interactive call from a terminal (docker exec/run -it, compose exec/run without -T) → ssh must allocate one"""
    if not sys.stdin.isatty():
        return False
    words = [a for a in args if not a.startswith("-")]
    if compose:
        return bool(words) and words[0] in ("exec", "run") and "-T" not in args and "--no-TTY" not in args
    flags = "".join(a[1:] for a in args if a.startswith("-") and not a.startswith("--"))
    return bool(words) and words[0] in ("exec", "run", "attach") and ("t" in flags or "--tty" in args)


def docker_argv(name, d, args):
    """docker CLI for a docker service: ssh hosts run docker remotely (local files are never touched), sockets via a context"""
    if d.get("mode", "socket") == "ssh":
        sudo = docker_sudo(d)
        return ["ssh"] + (["-t", "-q"] if wants_tty(args) else []) + [d["ssh_host"], f"{sudo + ' ' if sudo else ''}docker {shlex.join(args)}"]
    return ["docker", "--context", name, *args]


def docker_target(name, d):
    if d.get("mode", "socket") == "ssh":
        return f"ssh://{d['ssh_host']}"
    return f"unix://{SOCK_DIR}/docker-{name}.sock"


def docker_services(services, usable=True):
    out = {}
    for n, s in services.items():
        if "docker" in s and (not usable or (enabled(s) and not missing_vars(s["docker"]))):
            out[n] = s
    return out


def sync_docker_contexts(services):
    try:
        with open(DOCKER_STATE) as f:
            managed = set(json.load(f))
    except (FileNotFoundError, ValueError):
        managed = set()
    active = set()
    for name, svc in docker_services(services).items():
        d = render(svc["docker"])
        if d.get("mode", "socket") == "ssh":  # svc docker/compose run docker on the host through ssh – no context needed
            print(f"  ✓ {name} (docker via ssh {d['ssh_host']}{' + sudo' if docker_sudo(d) else ''}, {d.get('access', 'ro')})")
            continue
        host = docker_target(name, d)
        exists = subprocess.run(["docker", "context", "inspect", name], capture_output=True).returncode == 0
        verb = "update" if exists else "create"
        r = subprocess.run(["docker", "context", verb, name, "--description", f"tentaclai service {name}",
                            "--docker", f"host={host}"], capture_output=True, text=True)
        if r.returncode == 0:
            active.add(name)
            print(f"  ✓ {name} (docker {d.get('mode', 'socket')}: {host}, {d.get('access', 'ro')})")
        else:
            print(f"  ✗ {name}: docker context: {(r.stderr or r.stdout).strip()[:160]}")
    for name in sorted(managed - active):
        subprocess.run(["docker", "context", "rm", "-f", name], capture_output=True)
        print(f"  – {name}: docker context removed")
    os.makedirs(os.path.dirname(DOCKER_STATE), exist_ok=True)
    with open(DOCKER_STATE, "w") as f:
        json.dump(sorted(active), f)


def _ro_allowed(args, compose=False):
    words = [a for a in args if not a.startswith("-")]
    if not words:
        return True
    if compose:
        return words[0] in RO_COMPOSE
    if words[0] not in RO_DOCKER:
        return False
    if words[0] in ("network", "volume", "image", "container", "system", "context"):
        return len(words) > 1 and words[1] in RO_SUB
    return True


def get_docker(services, name):
    svc = get(services, name)
    if "docker" not in svc:
        sys.exit(f"svc: {name} is not a docker service (svc docker)")
    if not enabled(svc):
        sys.exit(f"svc: {name} is disabled")
    miss = missing_vars(svc["docker"])
    if miss:
        sys.exit(f"svc: {name} not enabled – empty in .env: {', '.join(miss)}")
    return render(svc["docker"])


def cmd_docker(services, args):
    if not args:
        ds = docker_services(services, usable=False)
        if not ds:
            print("No docker services.")
            return 0
        print(f"{'Name':<16}{'Mode':<8}{'Access':<9}{'Target':<34}Stacks")
        for n, s in ds.items():
            d = render(s["docker"])
            target = d.get("socket", "/var/run/docker.sock") if d.get("mode", "socket") == "socket" else f"ssh {d.get('ssh_host')}"
            if d.get("mode", "socket") == "ssh" and ssh_sudo(d.get("ssh_host", "")):
                target += " (sudo)"
            st = status(s)
            print(f"{n:<16}{d.get('mode', 'socket'):<8}{d.get('access', 'ro'):<9}{target:<34}{d.get('stacks_dir', '–')}"
                  + ("" if st == "active" else f"  ({st})"))
        return 0
    if args[0] == "dirs":
        for n, s in docker_services(services).items():
            d = render(s["docker"])
            if d.get("mode", "socket") == "socket" and d.get("stacks_dir"):
                print(f"{n}\t{d['stacks_dir']}")
        return 0
    name, rest = args[0], args[1:]
    d = get_docker(services, name)
    run = lambda: subprocess.call(docker_argv(name, d, rest))  # noqa: E731
    if _ro_allowed(rest):
        return run()
