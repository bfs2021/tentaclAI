class _HTMLText(HTMLParser):
    """small HTML → markdown-ish text converter (headings, paragraphs, lists, links, code)"""
    SKIP = {"script", "style", "noscript", "svg", "template", "head"}
    BLOCK = {"p", "div", "section", "article", "main", "header", "footer", "table", "tr", "br", "hr", "form", "blockquote", "dl", "dt", "dd"}

    def __init__(self, base):
        super().__init__(convert_charrefs=True)
        self.base, self.out, self.skip, self.links, self.title, self._title, self._href, self._pre = base, [], 0, [], "", False, None, 0

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag in self.SKIP:
            self.skip += 1
        elif tag == "title":
            self._title = True
        elif tag in ("h1", "h2", "h3", "h4", "h5", "h6"):
            self.out.append("\n\n" + "#" * int(tag[1]) + " ")
        elif tag == "li":
            self.out.append("\n- ")
        elif tag in ("td", "th"):
            self.out.append(" | ")
        elif tag == "pre":
            self._pre += 1
            self.out.append("\n```\n")
        elif tag == "code" and not self._pre:
            self.out.append("`")
        elif tag == "a" and a.get("href"):
            from urllib.parse import urljoin
            self._href = urljoin(self.base, a["href"])
            self.out.append("[")
        elif tag in self.BLOCK:
            self.out.append("\n")

    def handle_endtag(self, tag):
        if tag in self.SKIP:
            self.skip = max(0, self.skip - 1)
        elif tag == "title":
            self._title = False
        elif tag == "pre":
            self._pre = max(0, self._pre - 1)
            self.out.append("\n```\n")
        elif tag == "code" and not self._pre:
            self.out.append("`")
        elif tag == "a" and self._href:
            self.out.append(f"]({self._href})")
            self.links.append(self._href)
            self._href = None
        elif tag in self.BLOCK or tag in ("h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol"):
            self.out.append("\n")

    def handle_data(self, data):
        if self._title:
            self.title += data
        if self.skip:
            return
        self.out.append(data if self._pre else re.sub(r"\s+", " ", data))

    def text(self):
        t = "".join(self.out)
        t = re.sub(r"[ \t]+\n", "\n", t)
        return re.sub(r"\n{3,}", "\n\n", t).strip()


def web_paths(name):
    d = os.path.expanduser("~/.cache/tentaclaude/web")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return os.path.join(d, f"{name}.cookies")


def web_url(name, web, path):
    from urllib.parse import urlparse
    base = web["base_url"].rstrip("/")
    url = path if path.startswith(("http://", "https://")) else base + "/" + path.lstrip("/")
    b, u = urlparse(base), urlparse(url)
    if (u.scheme, u.netloc) != (b.scheme, b.netloc):
        sys.exit(f"svc: {name}: only URLs on {b.scheme}://{b.netloc} are allowed")
    allow = web.get("paths") or []
    if allow and not any(u.path.startswith(p) for p in allow):
        sys.exit(f"svc: {name}: path not allowed (paths: {', '.join(allow)})")
    return url


def web_curl(name, web, url, method="GET", data_lines=(), out=None):
    """curl with auth in a 0600 config file and a per-service cookie jar; returns (code, http_status, final_url, content_type, body)"""
    auth, jar = web.get("auth") or {"type": "none"}, web_paths(name)
    cfg = ['url = ' + _q(url), 'location', 'max-redirs = 10', 'max-time = 30', f'cookie-jar = {_q(jar)}', f'cookie = {_q(jar)}',
           'user-agent = "tentaclaude (+svc web)"', 'write-out = "\\n%{http_code} %{url_effective} %{content_type}"']
    t = auth.get("type", "none")
    if t == "basic":
        cfg.append(f'user = {_q(auth["user"] + ":" + auth["password"])}')
    elif t == "bearer":
        cfg.append(f'header = {_q("Authorization: Bearer " + auth["token"])}')
    elif t == "header":
        cfg.append(f'header = {_q(auth["header"] + ": " + auth["value"])}')
    for h, v in (web.get("headers") or {}).items():
        cfg.append(f'header = {_q(h + ": " + v)}')
    if method == "POST":
        cfg.append('request = "POST"')
        cfg += [f'data-urlencode = {_q(l)}' for l in data_lines]
    if web.get("insecure_tls"):
        cfg.append("insecure")
    if not os.path.exists(jar):
        open(jar, "w").close()
        os.chmod(jar, 0o600)
    code, stdout, stderr = _curl_secret([], cfg)
    body, _, meta = stdout.rpartition("\n")
    parts = meta.split(" ", 2) + ["", "", ""]
    return code, parts[0], parts[1], parts[2], (body if code == 0 else stderr.strip())


def web_login(name, web):
    a = web["auth"]
    login = web_url(name, web, a.get("login_url", "/login"))
    fields = dict(a.get("fields") or {})
    if a.get("csrf_field"):  # fetch the login form first and copy its hidden token
        code, st, final, ctype, body = web_curl(name, web, login)
        m = re.search(r'name=["\']' + re.escape(a["csrf_field"]) + r'["\'][^>]*value=["\']([^"\']*)', body) or \
            re.search(r'value=["\']([^"\']*)["\'][^>]*name=["\']' + re.escape(a["csrf_field"]), body)
        if m:
            fields[a["csrf_field"]] = m.group(1)
    code, st, final, ctype, body = web_curl(name, web, login, "POST", [f"{k}={v}" for k, v in fields.items()])
    return code == 0 and st[:1] in ("2", "3")


def web_fetch(name, web, path):
    url = web_url(name, web, path)
    form = (web.get("auth") or {}).get("type") == "form"
    jar = web_paths(name)
    if form and (not os.path.exists(jar) or os.path.getsize(jar) == 0):
        web_login(name, web)
    res = web_curl(name, web, url)
    if form:
        login_path = web_url(name, web, web["auth"].get("login_url", "/login")).split("?")[0]
        if res[1] in ("401", "403") or res[2].split("?")[0] == login_path:
            web_login(name, web)
            res = web_curl(name, web, url)
    return res


def cmd_web(services, args):
    webs = part_services(services, "web")
    if not args:
        if not webs:
            print("No web sources.")
            return 0
        print(f"{'Name':<16}{'Auth':<9}{'URL':<44}Status")
        for n, s in webs.items():
            w = render(s["web"])
            print(f"{n:<16}{(w.get('auth') or {}).get('type', 'none'):<9}{w.get('base_url', ''):<44}{status(s)}")
        return 0
    name, rest = args[0], args[1:]
    web = get_part(services, name, "web")
    mode = "text"
    while rest and rest[0] in ("--raw", "--links", "--login"):
        mode, rest = rest[0][2:], rest[1:]
    if mode == "login":
        ok = web_login(name, web)
        print(f"{name}: login {'ok' if ok else 'failed'}")
        return 0 if ok else 1
    path = rest[0] if rest else "/"
    code, st, final, ctype, body = web_fetch(name, web, path)
    if code != 0:
        sys.exit(f"svc: {name}: {body[:200]}")
    if mode == "raw" or "html" not in ctype:
        sys.stdout.write(body)
        return 0 if st.startswith("2") else 1
    p = _HTMLText(final)
    p.feed(body)
    if mode == "links":
        base = web["base_url"].split("/")[2]
        for l in dict.fromkeys(l for l in p.links if l.split("/")[2:3] == [base]):
            print(l)
        return 0
    limit = int(web.get("max_chars", 40000))
    text = p.text()
    print(f"# {p.title.strip() or final}\n<{final}>  HTTP {st}\n")
    print(text[:limit] + (f"\n\n… truncated after {limit} characters" if len(text) > limit else ""))
    return 0 if st.startswith("2") else 1


def web_test(name, web):
    code, st, final, ctype, body = web_fetch(name, web, web.get("test_path", "/"))
    if code != 0:
        return False, body[:180]
    title = re.search(r"<title[^>]*>(.*?)</title>", body, re.S | re.I)
    form = (web.get("auth") or {}).get("type") == "form"
    login_hit = form and final.split("?")[0].endswith(web["auth"].get("login_url", "/login").split("?")[0])
    ok = st.startswith("2") and not login_hit
    return ok, f"{final} → HTTP {st}" + (f" „{title.group(1).strip()[:60]}“" if title else "") + (" (still on the login page)" if login_hit else "")


# ---------- directories / files on SSH hosts (files) ----------

def files_target(name, f):
    host = f.get("ssh_host") or sys.exit(f"svc: {name}: files.ssh_host missing (or a system with an SSH host)")
    root = (f.get("path") or "").rstrip("/") or sys.exit(f"svc: {name}: files.path missing")
    sudo = ssh_sudo(host) if f.get("sudo") else ""
    return host, root, sudo


def files_sub(root, sub):
    sub = (sub or "").strip()
    if sub.startswith("/") or ".." in sub.split("/"):
        sys.exit("svc: paths are relative to the service path and may not contain '..'")
    return root + ("/" + sub if sub and sub != "." else "")


def files_ssh(host, sudo, cmd):
    return subprocess.call(["ssh", host, (sudo + " " if sudo else "") + cmd])


def cmd_files(services, args):
    fs = part_services(services, "files")
    if not args:
        if not fs:
            print("No file services.")
            return 0
        print(f"{'Name':<16}{'Access':<8}{'Target':<44}Status")
        for n, s in fs.items():
            f = render(s["files"])
            print(f"{n:<16}{f.get('access', 'ro'):<8}{(f.get('ssh_host') or '?') + ':' + f.get('path', ''):<44}{status(s)}")
        return 0
    if len(args) < 2:
        sys.exit("usage: svc files <name> ls|tree|cat|grep|pull|diff|push [path]")
    name, op, rest = args[0], args[1], args[2:]
    f = get_part(services, name, "files")
    host, root, sudo = files_target(name, f)
    rw = f.get("access", "ro") == "rw"
    local = os.path.join("/workspace/files", name)
    if op == "ls":
        return files_ssh(host, sudo, f"ls -la --group-directories-first {shlex.quote(files_sub(root, rest[0] if rest else ''))}")
    if op == "tree":
        return files_ssh(host, sudo, f"find {shlex.quote(files_sub(root, rest[0] if rest else ''))} -maxdepth {int(f.get('tree_depth', 3))} "
                                     f"-not -path '*/.git/*' | sort | head -500")
    if op == "cat" and rest:
        return files_ssh(host, sudo, f"cat {shlex.quote(files_sub(root, rest[0]))}")
    if op == "grep" and rest:
        return files_ssh(host, sudo, f"grep -rIn --color=never -m 20 -e {shlex.quote(rest[0])} "
                                     f"{shlex.quote(files_sub(root, rest[1] if len(rest) > 1 else ''))} | head -300")
    if op in ("pull", "diff", "push"):
        sub = rest[0] if rest else ""
        remote, dest = files_sub(root, sub), os.path.join(local, sub) if sub else local
        if op == "push" and not rw:
            sys.exit(f"svc: {name} is read-only – push is not allowed")
        is_dir = subprocess.run(["ssh", host, (sudo + " " if sudo else "") + f"test -d {shlex.quote(remote)}"]).returncode == 0
        src_r, src_l = (remote + "/", dest.rstrip("/") + "/") if is_dir else (remote, dest)
        base = ["rsync", "-a", "--exclude=.git/"] + ([f"--rsync-path={sudo} rsync"] if sudo else [])
        if op == "pull":
            os.makedirs(dest if is_dir else os.path.dirname(dest) or local, exist_ok=True)
            r = subprocess.call(base + [f"{host}:{src_r}", src_l])
            if r == 0:
                print(f"→ {dest}  (edit there; changes go back with: svc files {name} diff|push{' ' + sub if sub else ''})")
            return r
        if not os.path.exists(dest):
            sys.exit(f"svc: {dest} not found – pull first")
        if op == "diff":
            return subprocess.call(base + ["-n", "-i", "--checksum", src_l, f"{host}:{src_r}"])
        return subprocess.call(base + ["-i", src_l, f"{host}:{src_r}"])
    sys.exit("usage: svc files <name> ls|tree|cat <file>|grep <pattern> [path]|pull|diff|push [path]")


def files_test(name, f):
    host, root, sudo = files_target(name, f)
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host,
                        (sudo + " " if sudo else "") + f"sh -c 'if [ -d {shlex.quote(root)} ]; then echo dir $(ls -A {shlex.quote(root)} | wc -l); "
                        f"elif [ -e {shlex.quote(root)} ]; then echo file; else echo missing; fi'"],
                       capture_output=True, text=True, timeout=30)
    out = r.stdout.strip()
    if r.returncode != 0:
        return False, (r.stderr.strip().splitlines() or ["ssh failed"])[-1][:180]
    if out.startswith("dir"):
        return True, f"{host}:{root} – directory, {out.split()[1]} entries ({f.get('access', 'ro')}{', sudo' if sudo else ''})"
    if out == "file":
        return True, f"{host}:{root} – file ({f.get('access', 'ro')})"
    return False, f"{host}:{root} not found"


# ---------- connection test ----------

def cmd_test(services, name):
    svc = get(services, name)
    if not enabled(svc):
        print(f"– {name}: disabled")
        return 1
    ok_all = True

    def report(part, ok, msg):
        nonlocal ok_all
        ok_all &= ok
        print(f"{'✓' if ok else '✗'} {part}: {msg}")

    for part in PARTS:
        if part not in svc:
            continue
        miss = missing_vars(svc[part])
        if miss:
            report(part, False, f"empty in .env: {', '.join(miss)}")
            continue
        if part == "api":
            path = svc.get("test_path", "/")
            r = subprocess.run([sys.argv[0], name, "GET", path, "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10"],
                               capture_output=True, text=True)
            code = r.stdout.strip()
            good = r.returncode == 0 and code[:1] in ("2", "3")
            report("api", good, f"GET {path} → HTTP {code or '–'}" + ("" if good else f" {r.stderr.strip()[-120:]}"))
        elif part == "mcp":
            m = render(svc["mcp"])
            if m.get("type", "http") in ("http", "sse"):
                hdr = [f"{k}: {v}" for k, v in (m.get("headers") or {}).items()]
                cfg = [f"url = {_q(m['url'])}", 'header = "Accept: application/json, text/event-stream"'] + [f"header = {_q(h)}" for h in hdr]
                rc, out, err = _curl_secret(["-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10"], cfg)
                good = rc == 0 and out not in ("", "000", "401", "403", "404")
                report("mcp", good, f"{m['url']} reachable → HTTP {out or '–'}" + (" (authentication rejected)" if out in ("401", "403") else ""))
            else:
                found = subprocess.run(["sh", "-c", f"command -v {m.get('command', '')}"], capture_output=True).returncode == 0
                report("mcp", found, f"stdio command {m.get('command')} {'found' if found else 'not found'}")
        elif part == "git":
            g = svc["git"]
            args = ["-c", "credential.helper="]
            if uses_token(g):
                args += ["-c", f"credential.helper=!svc git-credential {name}"]
            r = git_run(args + ["ls-remote", "--heads", g["url"]], quiet=True)
            heads = len(r.stdout.splitlines())
            report("git", r.returncode == 0, f"{g['url']} → {heads} Branches" if r.returncode == 0 else (r.stderr.strip()[-160:] or "error"))
        elif part == "docker":
            d = render(svc["docker"])
            argv = docker_argv(name, d, ["version", "--format", "{{.Server.Version}}"])
            r = subprocess.run(argv, capture_output=True, text=True, timeout=40)
            if r.returncode != 0 and "context" in r.stderr and "not found" in r.stderr:
                sync_docker_contexts(services)
                r = subprocess.run(argv, capture_output=True, text=True, timeout=40)
            report("docker", r.returncode == 0, f"Docker {r.stdout.strip()}" if r.returncode == 0 else r.stderr.strip()[-160:])
        elif part in ("db", "web", "files"):
            try:
                ok, detail = {"db": db_test, "web": web_test, "files": files_test}[part](name, render(svc[part]))
            except (subprocess.TimeoutExpired, OSError, KeyError) as e:
                ok, detail = False, f"error: {e}"
            report(part, ok, detail)
    return 0 if ok_all else 1


