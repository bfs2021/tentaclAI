#!/usr/bin/env python3
"""svc – homelab service registry for tentaclaude.

One JSON file per service in $TC_DIR/services/*.json.
A service can have an "api", an "mcp" and/or a "git" part. Secrets are ${VAR} placeholders,
resolved from the stack's .env (read fresh on every call) and the container environment.

  svc list                         services, types, system, status (missing variables)
  svc systems [name]               systems (groups of services on one host) with SSH host, members and rules
  svc info <name>                  description, URLs, docs, examples, notes (no secrets)
  svc sync                         MCP -> Claude user config, clone missing git repos, regenerate /workspace/SERVICES.md
  svc <name> <METHOD> <path> [curl args...]
                                   API call with auth injected, e.g.
                                   svc arcane GET /environments
                                   svc mealie POST /households/shopping/items -d '{"note":"milk"}'
  svc git                          git repos: path, access (ro/rw), branch, ahead/behind, changes
  svc git sync [name...]           clone missing repos, apply ro/rw + credentials, fetch
  svc docker                       Docker hosts (local socket or via ssh): mode, target, stacks dir, access
  svc docker <name> <args...>      docker CLI against that host, e.g. svc docker gate ps
  svc compose <name> <stack> <args...>
                                   docker compose in <stacks_dir>/<stack> of that host, e.g. svc compose gate pangolin ps
  (access "ro": only read-only docker/compose commands are allowed)
  svc test <name>                  connection test of every part (api, mcp, git, docker, db, web, files)
  svc db [name] "<SQL>" | tables | describe <t> | shell    databases (postgres, mysql/mariadb); [--csv]
  svc web [name] [--links|--raw|--login] [path]          web sources: page as readable text, links, raw HTML
  svc files [name] ls|tree|cat|grep|pull|diff|push [path] directories/files on SSH hosts (pull → /workspace/files/<name>)
"""
import glob
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import hashlib
import shlex
from html.parser import HTMLParser

TC_DIR = os.environ.get("TC_DIR", "/opt/tentaclaude")
SERVICES_DIR = os.environ.get("SVC_DIR", os.path.join(TC_DIR, "services"))
SYSTEMS_DIR = os.path.join(TC_DIR, "systems")
PARTS = ("api", "mcp", "git", "docker", "db", "web", "files")
# Values from the stack's .env win over the container environment, so new tokens work without recreating
ENV_FILE = os.environ.get("SVC_ENV_FILE", os.path.join(TC_DIR, ".env"))
CATALOG = os.environ.get("SVC_CATALOG", "/workspace/SERVICES.md")
REPO_ROOT = os.environ.get("SVC_REPO_ROOT", "/workspace/repos")
STATE = os.path.expanduser("~/.config/tentaclaude/mcp-managed.json")
OAUTH_CACHE = os.path.expanduser("~/.cache/tentaclaude/oauth")
DOCKER_STATE = os.path.expanduser("~/.config/tentaclaude/docker-managed.json")
SOCK_DIR = "/run/tentaclaude"  # local sockets are mounted here as docker-<name>.sock (compose.generated.yaml)
RO_DOCKER = {"ps", "inspect", "logs", "images", "info", "version", "stats", "top", "port", "diff", "history", "events",
             "network", "volume", "image", "container", "system", "context"}
RO_SUB = {"ls", "list", "inspect", "ps", "logs", "df", "info", "top", "port", "diff", "history", "show"}
RO_COMPOSE = {"ps", "logs", "config", "ls", "images", "top", "port", "version", "events"}
VAR = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")
RO_PUSHURL = "READ-ONLY--push-disabled-by-tentaclaude"
HOOK_MARK = "# tentaclaude read-only hook"


# ---------- loading ----------

def load_env_file():
    line_re = re.compile(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")
    try:
        with open(ENV_FILE) as f:
            for line in f:
                m = line_re.match(line)
                if m:
                    v = m.group(2).strip()
                    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                        v = v[1:-1]
                    os.environ[m.group(1)] = v
    except OSError:
        pass


def load():
    services = {}
    for path in sorted(glob.glob(os.path.join(SERVICES_DIR, "*.json"))):
        base = os.path.basename(path)
        if base.startswith("_"):
            continue
        try:
            with open(path) as f:
                svc = json.load(f)
        except ValueError as e:
            print(f"svc: {base}: invalid JSON ({e})", file=sys.stderr)
            continue
        svc.setdefault("name", base[:-5])
        services[svc["name"]] = svc
    # a docker service of mode ssh without ssh_host uses the SSH host of its system
    systems = load_systems()
    for svc in services.values():
        d, sysd = svc.get("docker"), systems.get(svc.get("system", ""))
        if d and d.get("mode") == "ssh" and not d.get("ssh_host") and sysd and sysd.get("ssh_host"):
            d["ssh_host"] = sysd["ssh_host"]
        f = svc.get("files")
        if f and not f.get("ssh_host") and sysd and sysd.get("ssh_host"):
            f["ssh_host"] = sysd["ssh_host"]
    return services


def load_systems():
    """systems/*.json – groups of services (one host or appliance) with shared description, SSH host and rules"""
    systems = {}
    for path in sorted(glob.glob(os.path.join(SYSTEMS_DIR, "*.json"))):
        base = os.path.basename(path)
        if base.startswith("_"):
            continue
        try:
            with open(path) as f:
                s = json.load(f)
        except ValueError as e:
            print(f"svc: systems/{base}: invalid JSON ({e})", file=sys.stderr)
            continue
        s.setdefault("name", base[:-5])
        systems[s["name"]] = s
    return systems


def members(services, system):
    return [n for n, s in services.items() if s.get("system") == system]


def cmd_systems(services, name=None):
    systems = load_systems()
    if name:
        s = systems.get(name) or sys.exit(f"svc: unknown system '{name}' (svc systems)")
        print(f"# {name} – {s.get('description', '')}")
        if s.get("ssh_host"):
            sudo = ssh_sudo(s["ssh_host"])
            print(f"SSH:  ssh {s['ssh_host']}" + (f"  (privileged: {sudo} <cmd>)" if sudo else ""))
        for n in members(services, name):
            print(f"  - {n:<16}{kinds(services[n]):<14}{status(services[n])}  {services[n].get('description', '')}")
        for note in s.get("notes", []):
            print(f"  ! {note}")
        return 0
    if not systems:
        print("No systems (groups of services) – everything is standalone.")
        return 0
    print(f"{'System':<16}{'SSH':<14}Services")
    for n, s in systems.items():
        print(f"{n:<16}{s.get('ssh_host') or '–':<14}{', '.join(members(services, n)) or '–'}")
    loose = [n for n, s in services.items() if s.get("system") not in systems]
    if loose:
        print(f"{'(standalone)':<16}{'':<14}{', '.join(loose)}")
    return 0


def variables(obj):
    found = set()
    if isinstance(obj, str):
        found.update(VAR.findall(obj))
    elif isinstance(obj, list):
        for v in obj:
            found |= variables(v)
    elif isinstance(obj, dict):
        for k, v in obj.items():
            if not k.startswith("_"):
                found |= variables(v)
    return found


def render(obj):
    if isinstance(obj, str):
        return VAR.sub(lambda m: os.environ.get(m.group(1), ""), obj)
    if isinstance(obj, list):
        return [render(v) for v in obj]
    if isinstance(obj, dict):
        return {k: render(v) for k, v in obj.items() if not k.startswith("_")}
    return obj


def missing_vars(part):
    return sorted(v for v in variables(part) if not os.environ.get(v))


def enabled(svc):
    return svc.get("enabled", True) is not False


def status(svc):
    if not enabled(svc):
        return "disabled"
    miss = set()
    for part in PARTS:
        miss |= set(missing_vars(svc.get(part, {})))
    return "missing: " + ", ".join(sorted(miss)) if miss else "active"


def kinds(svc):
    return "+".join(k for k in PARTS if k in svc) or "-"


def get(services, name):
    return services.get(name) or sys.exit(f"svc: unknown service '{name}' (svc list)")


# ---------- api ----------

def cmd_call(services, name, method, path, extra):
    svc = get(services, name)
    if not enabled(svc):
        sys.exit(f"svc: {name} is disabled")
    api = svc.get("api") or sys.exit(f"svc: {name} has no api part")
    miss = missing_vars(api)
    if miss:
        sys.exit(f"svc: {name} not enabled – empty in .env: {', '.join(miss)}")
    api = render(api)
    url = api["base_url"].rstrip("/") + "/" + path.lstrip("/")
    auth = api.get("auth", {"type": "none"})
    headers = [f"{k}: {v}" for k, v in api.get("headers", {}).items()]
    config = []
    t = auth.get("type", "none")
    if t == "bearer":
        headers.append(f"Authorization: Bearer {auth['token']}")
    elif t == "header":
        headers.append(f"{auth['header']}: {auth['value']}")
    elif t == "basic":
        config.append(f'user = "{auth["user"]}:{auth["password"]}"')
    elif t == "query":
        url += ("&" if "?" in url else "?") + f"{auth['param']}={auth['value']}"
    elif t == "oauth2_client_credentials":
        headers.append(f"Authorization: Bearer {oauth_token(name, auth, api.get('insecure_tls'))}")
    if not any(a.lower().startswith("content-type") for a in extra) and any(a in ("-d", "--data", "--data-raw", "--json") for a in extra):
        headers.append("Content-Type: application/json")
    # secrets (headers, basic auth, URL with query token) go through 0600 files on tmpfs, never into argv
    config.append('url = "' + url.replace("\\", "\\\\").replace('"', '\\"') + '"')
    files = []
    try:
        for content in ("\n".join(headers) + "\n", "\n".join(config) + "\n"):
            with tempfile.NamedTemporaryFile("w", dir="/dev/shm", delete=False) as fh:
                fh.write(content)
                files.append(fh.name)
        cmd = ["curl", "-sS", "-X", method.upper(), "-H", f"@{files[0]}", "-K", files[1]]
        if api.get("insecure_tls"):
            cmd.append("-k")
        return subprocess.call(cmd + list(extra))
    finally:
        for f in files:
            os.unlink(f)


# ---------- oauth2 (client credentials) ----------

def _curl_secret(argv_head, config_lines):
    """run curl with secrets only in a 0600 config file on tmpfs; return stdout"""
    with tempfile.NamedTemporaryFile("w", dir="/dev/shm", delete=False) as fh:
        fh.write("\n".join(config_lines) + "\n")
        cfg = fh.name
    try:
        r = subprocess.run(["curl", "-sS", *argv_head, "-K", cfg], capture_output=True, text=True)
        return r.returncode, r.stdout, r.stderr
    finally:
        os.unlink(cfg)


def _q(v):
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


def oauth_token(name, auth, insecure=False):
    """client_credentials grant with on-disk cache (0600) until shortly before expiry"""
    key = hashlib.sha256(f"{auth['token_url']}|{auth['client_id']}|{auth.get('scope', '')}".encode()).hexdigest()[:16]
    path = os.path.join(OAUTH_CACHE, f"{name}.json")
    try:
        with open(path) as f:
            c = json.load(f)
        if c.get("key") == key and c.get("expires_at", 0) > time.time() + 60:
            return c["access_token"]
    except (OSError, ValueError):
        pass
    cfg = [f"url = {_q(auth['token_url'])}", "request = POST",
           'header = "Content-Type: application/x-www-form-urlencoded"',
           'data-urlencode = "grant_type=client_credentials"']
    if auth.get("scope"):
        cfg.append(f"data-urlencode = {_q('scope=' + auth['scope'])}")
    if auth.get("audience"):
        cfg.append(f"data-urlencode = {_q('audience=' + auth['audience'])}")
    if auth.get("client_auth", "body") == "basic":
        cfg.append(f"user = {_q(auth['client_id'] + ':' + auth['client_secret'])}")
    else:
        cfg.append(f"data-urlencode = {_q('client_id=' + auth['client_id'])}")
        cfg.append(f"data-urlencode = {_q('client_secret=' + auth['client_secret'])}")
    rc, out, err = _curl_secret(["-k"] if insecure else [], cfg)
    try:
        data = json.loads(out)
        token = data["access_token"]
    except (ValueError, KeyError):
        sys.exit(f"svc: {name}: could not get an OAuth token ({(err or out).strip()[:200]})")
    os.makedirs(OAUTH_CACHE, mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"key": key, "access_token": token, "expires_at": time.time() + int(data.get("expires_in", 3600))}, f)
    return token


# ---------- git ----------

def repo_path(name, git):
    return git.get("path") or os.path.join(REPO_ROOT, name)


def git_run(args, cwd=None, quiet=False):
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    r = subprocess.run(["git", *args], cwd=cwd, env=env, capture_output=True, text=True)
    if r.returncode != 0 and not quiet:
        print(f"    git {' '.join(args[:2])}: {(r.stderr or r.stdout).strip()[:300]}")
    return r


def uses_token(git):
    return (git.get("auth") or {}).get("type") == "token"


def configure_repo(name, path, git):
    """apply credentials and ro/rw protection – idempotent, also switches ro <-> rw"""
    git_run(["config", "--unset-all", "credential.helper"], cwd=path, quiet=True)
    git_run(["config", "--add", "credential.helper", ""], cwd=path)  # ignore global helpers (e.g. gh)
    if uses_token(git):
        git_run(["config", "--add", "credential.helper", f"!svc git-credential {name}"], cwd=path)
    git_run(["config", "tentaclaude.service", name], cwd=path)
    access = git.get("access", "ro")
    git_run(["config", "tentaclaude.access", access], cwd=path)
    hook = os.path.join(path, ".git", "hooks", "pre-push")
    if access == "ro":
        git_run(["config", "remote.origin.pushurl", RO_PUSHURL], cwd=path)
        os.makedirs(os.path.dirname(hook), exist_ok=True)
        with open(hook, "w") as f:
            f.write(f"#!/bin/sh\n{HOOK_MARK}\necho 'tentaclaude: repo \"{name}\" is read-only – push blocked.' >&2\nexit 1\n")
        os.chmod(hook, 0o755)
    else:
        git_run(["config", "--unset", "remote.origin.pushurl"], cwd=path, quiet=True)
        if os.path.exists(hook) and HOOK_MARK in open(hook).read():
            os.remove(hook)


def git_sync(services, names=None, fetch=True):
    repos = {n: s for n, s in services.items() if "git" in s and (not names or n in names)}
    for name in names or []:
        if name not in repos:
            print(f"  ✗ {name}: not a git service")
    for name, svc in repos.items():
        git = svc["git"]
        if not enabled(svc):
            print(f"  – {name}: disabled")
            continue
        miss = missing_vars(git)
        if miss:
            print(f"  – {name}: skipped, empty in .env: {', '.join(miss)}")
            continue
        path = repo_path(name, git)
        if not os.path.isdir(os.path.join(path, ".git")):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            args = ["-c", "credential.helper="]
            if uses_token(git):
                args += ["-c", f"credential.helper=!svc git-credential {name}"]
            args += ["clone"] + (["--branch", git["branch"]] if git.get("branch") else []) + [git["url"], path]
            if git_run(args).returncode != 0:
                print(f"  ✗ {name}: clone failed")
                continue
            configure_repo(name, path, git)
            print(f"  ✓ {name}: cloned to {path} ({git.get('access', 'ro')})")
            continue
        configure_repo(name, path, git)
        if fetch:
            ok = git_run(["fetch", "--prune", "--quiet"], cwd=path).returncode == 0
            print(f"  {'✓' if ok else '✗'} {name}: {'updated (fetch)' if ok else 'fetch failed'} – {git.get('access', 'ro')}")
        else:
            print(f"  ✓ {name}: present ({git.get('access', 'ro')})")


def git_state(path):
    if not os.path.isdir(os.path.join(path, ".git")):
        return "not cloned"
    branch = git_run(["rev-parse", "--abbrev-ref", "HEAD"], cwd=path, quiet=True).stdout.strip()
    counts = git_run(["rev-list", "--left-right", "--count", "HEAD...@{upstream}"], cwd=path, quiet=True).stdout.split()
    dirty = bool(git_run(["status", "--porcelain"], cwd=path, quiet=True).stdout.strip())
    parts = [branch or "?"]
    if len(counts) == 2:
        if counts[0] != "0":
            parts.append(f"↑{counts[0]}")
        if counts[1] != "0":
            parts.append(f"↓{counts[1]}")
    if dirty:
        parts.append("changes")
    return " ".join(parts)


def cmd_git_list(services):
    repos = {n: s for n, s in services.items() if "git" in s}
    if not repos:
        print("No git services.")
        return
    print(f"{'Name':<18}{'Access':<9}{'Status':<28}Path")
    for name, svc in repos.items():
        git = svc["git"]
        path = repo_path(name, git)
        state = status(svc) if status(svc) != "active" else git_state(path)
        print(f"{name:<18}{git.get('access', 'ro'):<9}{state:<28}{path}")


def cmd_git_credential(services, name, op):
    """git credential helper protocol – answers 'get' with the token from .env"""
    sys.stdin.read()
    svc = services.get(name)
    if op != "get" or not svc or not enabled(svc) or "git" not in svc:
        return 0
    auth = render(svc["git"].get("auth") or {})
    if auth.get("type") == "token" and auth.get("token"):
        print(f"username={auth.get('username') or 'x-access-token'}")
        print(f"password={auth['token']}")
    return 0


# ---------- docker ----------

SSH_META = re.compile(r"^\s*#\s*tentaclaude:\s*sudo\s*=\s*(.*?)\s*$")


def ssh_sudo(alias):
    """sudo prefix configured for an SSH host ('# tentaclaude: sudo=sudo -n' inside its Host block), '' = none"""
    for f in sorted(glob.glob(os.path.expanduser("~/.ssh/config.d/*.conf"))):
        current = []
        for line in open(f):
            m = SSH_META.match(line)
            if m:
                if alias in current:
                    return m.group(1)
                continue
            parts = line.split()
            if parts and parts[0].lower() == "host":
                current = parts[1:]
    return ""


def docker_sudo(d):
    return ssh_sudo(d["ssh_host"]) if d.get("mode", "socket") == "ssh" else ""


def docker_argv(name, d, args):
    """docker CLI for a docker service: context, or plain ssh + sudo for hosts that need sudo"""
    sudo = docker_sudo(d)
    if sudo:
        return ["ssh", d["ssh_host"], f"{sudo} docker {shlex.join(args)}"]
    return ["docker", "--context", name, *args]


def docker_target(name, d):
    if d.get("mode", "socket") == "ssh":
        return f"ssh://{d['ssh_host']}"
    return f"unix://{SOCK_DIR}/docker-{name}.sock"


def docker_services(services, usable=True):
    out = {}
    for n, s in services.items():
        if "docker" in s and (not usable or (enabled(s) and not missing_vars(s["docker"]))):
            out[n] = s
    return out


def sync_docker_contexts(services):
    try:
        with open(DOCKER_STATE) as f:
            managed = set(json.load(f))
    except (FileNotFoundError, ValueError):
        managed = set()
    active = set()
    for name, svc in docker_services(services).items():
        d = render(svc["docker"])
        if docker_sudo(d):  # docker contexts can't use sudo – svc docker/compose go through ssh instead
            print(f"  ✓ {name} (docker ssh + sudo: {d['ssh_host']}, {d.get('access', 'ro')}, no docker context)")
            continue
        host = docker_target(name, d)
        exists = subprocess.run(["docker", "context", "inspect", name], capture_output=True).returncode == 0
        verb = "update" if exists else "create"
        r = subprocess.run(["docker", "context", verb, name, "--description", f"tentaclaude service {name}",
                            "--docker", f"host={host}"], capture_output=True, text=True)
        if r.returncode == 0:
            active.add(name)
            print(f"  ✓ {name} (docker {d.get('mode', 'socket')}: {host}, {d.get('access', 'ro')})")
        else:
            print(f"  ✗ {name}: docker context: {(r.stderr or r.stdout).strip()[:160]}")
    for name in sorted(managed - active):
        subprocess.run(["docker", "context", "rm", "-f", name], capture_output=True)
        print(f"  – {name}: docker context removed")
    os.makedirs(os.path.dirname(DOCKER_STATE), exist_ok=True)
    with open(DOCKER_STATE, "w") as f:
        json.dump(sorted(active), f)


def _ro_allowed(args, compose=False):
    words = [a for a in args if not a.startswith("-")]
    if not words:
        return True
    if compose:
        return words[0] in RO_COMPOSE
    if words[0] not in RO_DOCKER:
        return False
    if words[0] in ("network", "volume", "image", "container", "system", "context"):
        return len(words) > 1 and words[1] in RO_SUB
    return True


def get_docker(services, name):
    svc = get(services, name)
    if "docker" not in svc:
        sys.exit(f"svc: {name} is not a docker service (svc docker)")
    if not enabled(svc):
        sys.exit(f"svc: {name} is disabled")
    miss = missing_vars(svc["docker"])
    if miss:
        sys.exit(f"svc: {name} not enabled – empty in .env: {', '.join(miss)}")
    return render(svc["docker"])


def cmd_docker(services, args):
    if not args:
        ds = docker_services(services, usable=False)
        if not ds:
            print("No docker services.")
            return 0
        print(f"{'Name':<16}{'Mode':<8}{'Access':<9}{'Target':<34}Stacks")
        for n, s in ds.items():
            d = render(s["docker"])
            target = d.get("socket", "/var/run/docker.sock") if d.get("mode", "socket") == "socket" else f"ssh {d.get('ssh_host')}"
            if d.get("mode", "socket") == "ssh" and ssh_sudo(d.get("ssh_host", "")):
                target += " (sudo)"
            st = status(s)
            print(f"{n:<16}{d.get('mode', 'socket'):<8}{d.get('access', 'ro'):<9}{target:<34}{d.get('stacks_dir', '–')}"
                  + ("" if st == "active" else f"  ({st})"))
        return 0
    if args[0] == "dirs":
        for n, s in docker_services(services).items():
            d = render(s["docker"])
            if d.get("mode", "socket") == "socket" and d.get("stacks_dir"):
                print(f"{n}\t{d['stacks_dir']}")
        return 0
    name, rest = args[0], args[1:]
    d = get_docker(services, name)
    if d.get("access", "ro") == "ro" and not _ro_allowed(rest):
        sys.exit(f"svc: {name} is read-only – '{' '.join(rest[:2])}' is not allowed")
    return subprocess.call(docker_argv(name, d, rest))


def cmd_compose(services, name, stack, rest):
    d = get_docker(services, name)
    if d.get("access", "ro") == "ro" and not _ro_allowed(rest, compose=True):
        sys.exit(f"svc: {name} is read-only – 'compose {' '.join(rest[:1])}' is not allowed")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", stack):
        sys.exit("svc: invalid stack name")
    base = d.get("stacks_dir") or sys.exit(f"svc: {name} has no stacks_dir")
    path = os.path.join(base, stack)
    if d.get("mode", "socket") == "ssh":
        sudo = docker_sudo(d)
        remote = f"cd {shlex.quote(path)} && {sudo + ' ' if sudo else ''}docker compose {shlex.join(rest)}"
        return subprocess.call(["ssh", d["ssh_host"], remote])
    if not os.path.isdir(path):
        sys.exit(f"svc: {path} not found")
    return subprocess.call(["docker", "--context", name, "compose", *rest], cwd=path)


# ---------- shared: service part lookup ----------

def get_part(services, name, part):
    svc = get(services, name)
    if part not in svc:
        sys.exit(f"svc: {name} has no {part} part")
    if not enabled(svc):
        sys.exit(f"svc: {name} is disabled")
    miss = missing_vars(svc[part])
    if miss:
        sys.exit(f"svc: {name} not enabled – empty in .env: {', '.join(miss)}")
    return render(svc[part])


def part_services(services, part):
    return {n: s for n, s in services.items() if part in s}


def _shm_file(content):
    """0600 file on tmpfs for secrets – caller deletes it"""
    with tempfile.NamedTemporaryFile("w", dir="/dev/shm", delete=False) as fh:
        fh.write(content)
        return fh.name


# ---------- databases (db) ----------

DB_RO_BYPASS = re.compile(r"read\s+write|default_transaction_read_only|transaction_read_only|tx_read_only|"
                          r"session\s+characteristics|\bset\s+role\b|\bset\s+session\s+authorization\b", re.I)


def db_engine(db):
    e = (db.get("engine") or "postgres").lower()
    return "mysql" if e in ("mysql", "mariadb") else "postgres"


def db_run(name, db, sql=None, fmt="table", interactive=False):
    """run SQL (or an interactive client) – password only in env / a 0600 tmpfs file, ro enforced per session"""
    ro = db.get("access", "ro") != "rw"
    if sql is not None and ro and DB_RO_BYPASS.search(sql):
        sys.exit(f"svc: {name} is read-only – statements that change the transaction mode are not allowed")
    if db_engine(db) == "postgres":
        env = dict(os.environ, PGHOST=str(db.get("host", "")), PGPORT=str(db.get("port", 5432)),
                   PGDATABASE=str(db.get("database", "")), PGUSER=str(db.get("user", "")), PGPASSWORD=str(db.get("password", "")),
                   PGSSLMODE=str(db.get("ssl", "prefer")), PGAPPNAME="tentaclaude", PGCONNECT_TIMEOUT="10")
        if ro:
            env["PGOPTIONS"] = "-c default_transaction_read_only=on"
        cmd = ["psql", "-X", "-v", "ON_ERROR_STOP=1"]
        if fmt == "csv":
            cmd.append("--csv")
        if sql is not None:
            cmd += ["-c", sql]
        return subprocess.call(cmd, env=env) if interactive or sql is not None else 0
    cfg = _shm_file("[client]\n" + "".join(f"{k}={v}\n" for k, v in (
        ("host", db.get("host", "")), ("port", db.get("port", 3306)), ("user", db.get("user", "")),
        ("password", db.get("password", "")), ("database", db.get("database", ""))) if v != ""))
    try:
        cmd = ["mariadb", f"--defaults-extra-file={cfg}", "--connect-timeout=10"]
        if db.get("ssl") in (True, "require", "true"):
            cmd.append("--ssl")
        if ro:
            cmd.append("--init-command=SET SESSION TRANSACTION READ ONLY")
        if sql is not None:
            cmd += (["--batch"] if fmt == "csv" else ["--table"]) + ["-e", sql]
        return subprocess.call(cmd)
    finally:
        os.unlink(cfg)


def cmd_db(services, args):
    dbs = part_services(services, "db")
    if not args:
        if not dbs:
            print("No database services.")
            return 0
        print(f"{'Name':<16}{'Engine':<10}{'Access':<8}{'Target':<36}Status")
        for n, s in dbs.items():
            d = render(s["db"])
            tgt = f"{d.get('host', '')}:{d.get('port') or (3306 if db_engine(d) == 'mysql' else 5432)}/{d.get('database', '')}"
            print(f"{n:<16}{db_engine(d):<10}{d.get('access', 'ro'):<8}{tgt:<36}{status(s)}")
        return 0
    name, rest = args[0], args[1:]
    db = get_part(services, name, "db")
    fmt = "table"
    if rest and rest[0] in ("--csv", "--tsv"):
        fmt, rest = "csv", rest[1:]
    if not rest:
        sys.exit(f"usage: svc db {name} \"<SQL>\" | tables | describe <table> | shell")
    pg = db_engine(db) == "postgres"
    if rest[0] == "shell":
        if db.get("access", "ro") != "rw":
            sys.exit(f"svc: {name} is read-only – use svc db {name} \"<SQL>\" (the shell could switch the session to read-write)")
        return db_run(name, db, interactive=True)
    if rest[0] == "tables":
