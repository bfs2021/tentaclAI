def main(argv):
    global ORIG_CWD
    elevate()
    try:
        ORIG_CWD = os.getcwd()
    except OSError:
        ORIG_CWD = "/"
    if privileged():
        os.chdir("/")  # nothing running as root reads files from Claude's current directory
    load_env_file()
    services = load()
    SERVICE_NAMES.update(services)
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = argv[1]
    if cmd == "list":
        return cmd_list(services)
    if cmd in ("systems", "system"):
        return cmd_systems(services, argv[2] if len(argv) > 2 else None)
    if cmd == "info" and len(argv) == 3:
        return cmd_info(services, argv[2])
    if cmd == "sync":
        return cmd_sync(services)
    if cmd == "git":
        if len(argv) >= 3 and argv[2] == "sync":
            return git_sync(services, argv[3:] or None)
        if len(argv) >= 4 and argv[2] in ("fetch", "pull"):
            return cmd_git_fetch(services, argv[3], pull=argv[2] == "pull")
        if len(argv) >= 4 and argv[2] == "push":
            return cmd_git_push(services, argv[3], argv[4:])
        return cmd_git_list(services)
    if cmd == "ssh":
        return cmd_ssh(argv[2:])
    if cmd == "mcp-proxy" and len(argv) == 3:
        return cmd_mcp_proxy(services, argv[2])
    if cmd == "rc-env":
        return cmd_rc_env()
    if cmd == "pending":
        return cmd_pending(argv[2:])
    if cmd == "config":
        return cmd_config(services, argv[2:])
    if cmd == "docker":
        return cmd_docker(services, argv[2:])
    if cmd == "test" and len(argv) == 3:
        return cmd_test(services, argv[2])
    if cmd == "audit":
        return cmd_audit(argv[2:])
    if cmd == "git-push-hook" and len(argv) >= 3:
        return git_push_hook(services, argv[2], argv[3:])
    if cmd == "db":
        return cmd_db(services, argv[2:])
    if cmd == "jobs":
        return cmd_jobs(argv[2:])
    if cmd in ("tool-report", "guard-report"):  # guard-report: the name before v0.20 (findings only)
        return cmd_tool_report(argv[2:])
    if cmd == "mail":
        return cmd_mail(services, argv[2:])
    if cmd == "web":
        return cmd_web(services, argv[2:])
    if cmd == "files":
        return cmd_files(services, argv[2:])
    if cmd == "compose" and len(argv) >= 5:
        return cmd_compose(services, argv[2], argv[3], argv[4:])
    if cmd == "git-credential" and len(argv) >= 4:
        return cmd_git_credential(services, argv[2], argv[3])
    if len(argv) >= 4:
        return cmd_call(services, argv[1], argv[2], argv[3], argv[4:])
    print(__doc__.strip())
    return 1


SERVICE_NAMES = set()
NOT_LOGGED = {"-h", "--help", "help", "pending", "audit", "guard-report", "tool-report", "mcp-proxy", "git-credential",
              "git-push-hook", "rc-env"}  # svc's own plumbing and lookups – no audit entry
ROOT_LOGGED = {"sync", "test", "git"}  # run by tentacontrol or the entrypoint: only these get an entry (pages poll the rest)


def read_entry(argv, rc, seconds):
    """the audit entry of a call that wrote none itself (a read): "read", with the command line, exit code and time"""
    if AUDITED or len(argv) < 2 or argv[1] in NOT_LOGGED or (privileged() and not via_sudo() and argv[1] not in ROOT_LOGGED):
        return
    if argv[1] == "ssh":
        name = argv[2] if len(argv) > 2 else ""
    else:
        name = argv[1] if argv[1] in SERVICE_NAMES else next((a for a in argv[2:] if a in SERVICE_NAMES), "")
    part = argv[1] if argv[1] in tclib.PARTS or argv[1] in ("ssh", "test", "sync", "jobs", "config") else \
        "api" if name == argv[1] else argv[1][:20]
    action = _redact_text(" ".join(["svc"] + argv[1:]))[:500]
    audit(name or "svc", part, "read", action, "read", rc=rc, duration=seconds)


def run(argv):
    t, rc = time.time(), 1
    try:
        rc = main(argv) or 0
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        raise
    finally:
        try:
            read_entry(argv, rc, time.time() - t)
        except Exception:  # noqa: BLE001 – the audit never fails a command
            pass
    return rc


if __name__ == "__main__":
    sys.exit(run(sys.argv))
