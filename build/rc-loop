#!/usr/bin/env bash
# Runs `claude remote-control` in a loop. Reads RC_* from the stack's .env (via svc) before every start:
#   RC_ENABLED       true|false          (false: wait and re-check)
#   RC_NAME          session name in claude.ai/code and the app
#   RC_WORKDIR       start directory
#   RC_EXTRA_ARGS    additional arguments for `claude remote-control`
#   RC_RESTART_DELAY seconds to wait after the session ended (default 30)
# runs as Claude, which can't read .env – `svc rc-env` hands over just these settings
val() {  # key default
    local v
    v="$(svc rc-env 2>/dev/null | sed -n "s/^$1=//p" | tail -1)"
    [ -n "$v" ] && eval "v=$v"  # shell-quoted by svc
    echo "${v:-$2}"
}

while true; do
    if [ "$(val RC_ENABLED true)" != "true" ]; then
        clear; echo "Remote control is disabled (RC_ENABLED=false) – checking again every 60 s."
        sleep 60; continue
    fi
    name="$(val RC_NAME tentaclai)"; dir="$(val RC_WORKDIR /workspace)"; extra="$(val RC_EXTRA_ARGS "")"
    delay="$(val RC_RESTART_DELAY 30)"
    [ -d "$dir" ] || dir=/workspace
    cd "$dir" || cd /workspace
    # RC_ENABLED=true is the consent – skip the interactive "Enable Remote Control? (y/n)" prompt
    node -e 'const fs=require("fs"),f=process.env.HOME+"/.claude.json";
        try { const d=JSON.parse(fs.readFileSync(f,"utf8")); if (!d.remoteDialogSeen) { d.remoteDialogSeen=true; fs.writeFileSync(f, JSON.stringify(d,null,2)); } } catch (e) {}' || true
    echo "▶ claude remote-control --name '$name' $extra   (in $dir)"
    # shellcheck disable=SC2086
    claude remote-control --name "$name" $extra
    echo; echo "remote-control ended – restarting in ${delay} s (Ctrl+C ends the loop)"
    sleep "$delay"
done
